# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Site Configuration  
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Recurring Payments Cron Job
# Generate a secure random string for this (e.g., openssl rand -base64 32)
# Vercel Cron only attaches "Authorization: Bearer <value>" to scheduled
# requests when a project env var named exactly CRON_SECRET exists. Set
# CRON_SECRET in the Vercel dashboard or NOTHING scheduled will run.
# CRON_SECRET_KEY is the legacy name, still accepted for manual callers.
CRON_SECRET=your-super-secret-cron-key-here
CRON_SECRET_KEY=your-super-secret-cron-key-here

# PortOne Platform API (for settlements and payouts)
PORTONE_API_SECRET=your_portone_api_secret_here
PORTONE_STORE_ID=your_portone_store_id_here

# Alert Configuration (optional)
ALERT_EMAIL_ENABLED=false
# Comma-separated. Receives CRITICAL operational alerts (dead cron,
# failed job) as well as the account-deletion digest. Leave blank to
# disable email; alerts still reach the admin dashboard and Sentry.
ALERT_EMAIL_RECIPIENTS=admin@classraum.com
ALERT_EMAIL_FROM=alerts@classraum.com
SLACK_WEBHOOK_URL=

# ───────────────────────────────────────────────────────────────────────
# Sentry Error Monitoring
# Get these from https://sentry.io after creating your project.
# Leaving them blank disables Sentry — the app still runs normally.
# See docs/SENTRY_SETUP.md for full setup instructions.
# ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# ─────────────────────────────────────────────────────────────────────
# Previously undocumented. Every variable below is read by src/ or
# scripts/ but was missing from this file — including the Supabase
# service-role key, read in 30 places. A test now fails CI if a new
# variable is read without being listed here, because an undocumented
# variable is invisible to onboarding and to review.
# ─────────────────────────────────────────────────────────────────────

# Supabase — server-side only. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — test generation, grading, transcription, TTS.
OPENAI_API_KEY=
# Optional override for the speaking audio grader model.
OPENAI_AUDIO_GRADE_MODEL=

# PortOne (payments). The store id is duplicated under both a public and
# a server name — keep them identical or checkout and refunds will hit
# different stores.
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY_PAYMENT_LIVE=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY_BILLING_LIVE=
# Required by validatePortOneConfig, but PortOne V2 authenticates with
# PORTONE_API_SECRET alone — this appears to be a vestigial V1 key.
PORTONE_API_KEY=
# Webhook signature secret. The payment webhooks reject in production
# when this is absent, so an empty value disables them entirely.
PORTONE_WEBHOOK_SECRET=

# KG Inicis (subscription callback hashing). Empty strings produce a
# valid-looking but wrong hash rather than an error — set both or neither.
KG_MID=
KG_MERCHANT_KEY=

# Postmark (transactional email). Without the token every send returns
# {sent:false} and never throws, so email fails silently.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=

# SOLAPI (SMS / AlimTalk). The client is constructed with undefined when
# these are absent — sends fail at runtime and are swallowed.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_NUMBER=
SOLAPI_KAKAO_CHANNEL_ID=

# Firebase Cloud Messaging (study push). Absent = push silently no-ops
# while the reminder cron still reports success.
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=

# Web push (browser). Absent = subscription returns null.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Analytics / marketing — all optional.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
NEXT_PUBLIC_KAKAO_JS_KEY=
NEXT_PUBLIC_KAKAO_CHANNEL_URL=

# OPTIONAL override for the numeric App Store id used by the /invite landing
# page. The live id (6757461159) is hardcoded in src/lib/deeplinks.ts because
# it never changes and an unset env var would silently hide the download
# button. Set this only to point a staging build at a different listing.
NEXT_PUBLIC_IOS_APP_STORE_ID=

# Misc.
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_APP_VERSION=
# Item-bank authoring scripts (scripts/study-bank/*).
# Which exam family a maths batch is inserted as. Was hardcoded 'sat' in
# math-bank-helper.mjs, so an SSAT or ISEE batch inserted through that path
# was filed as SAT — wrong blueprint and wrong scoring rule (SAT has no
# -1/4 penalty), and invisible afterwards because the rows look well formed.
# sat | ssat | isee
BANK_FAMILY=
BANK_COHORT=
# act-bank-helper.mjs update: free-text reason stored in verify_meta.repair_why
# on every row a post-attack repair rewrites (optional; has a default).
REPAIR_WHY=
# act-bank-helper.selftest.mjs: directory for its throwaway fixture files
# (optional; defaults to /tmp).
SCRATCH=
# draw-review-run.mjs: restrict a human sitting's pool to one family. Needed
# for ACT because "Craft and Structure" is also an SAT domain name.
DRAW_FAMILY=
# Section for verbal-bank-helper.mjs (SSAT/ISEE). Defaults to 'verbal';
# set to 'math' to bank the math cohorts through the same gated path.
BANK_SECTION=
# Insert past a QC gate refusal. Set it to a REASON string, not "1" — the
# reason is printed and must be recorded in the ledger afterwards. Exists for
# documented exceptions like orphan-repair batches, which legitimately carry
# fewer items than a gate expects. Leave empty; the gate is the point.
BANK_GATE_OVERRIDE=
# Target host for scripts/performance-ci.js.
BASE_URL=

# Base URL the camp verifier scripts (scripts/camp-*.mjs) exercise.
# Defaults to http://localhost:3000; point at a preview deploy to verify there.
CAMP_E2E_BASE=http://localhost:3000

# ── Social sign-in ───────────────────────────────────────────────────
# Comma-separated allow-list of enabled OAuth providers.
# Valid names: kakao, google, apple. Unknown names are ignored.
#
# LEAVE EMPTY UNTIL THE PROVIDER IS CONFIGURED. Empty (or unset) means no
# provider button renders anywhere and the auth page is identical to the
# pre-OAuth one — a button pointing at a provider with no client id is a
# dead end that looks like a broken product. Enable a provider here only
# after it works in the Supabase dashboard.
#
# Display order is fixed in code (kakao, google, apple) regardless of the
# order written here.
NEXT_PUBLIC_OAUTH_PROVIDERS=

# The Apple "Sign in with Apple" client secret — the generated JWT, NOT
# the .p8 file. A COPY of what is pasted into the Supabase dashboard,
# kept here only so /api/cron/apple-secret-expiry can read its `exp` and
# warn before it lapses. Apple caps these at 6 months, and when one
# expires Apple web sign-in breaks with no deploy and no error in our
# logs — which is the whole reason the job exists.
#
# ROTATE BOTH COPIES TOGETHER. Updating Supabase alone leaves the alert
# reporting a secret nobody is using; updating this alone silences the
# alert while sign-in stays broken.
APPLE_OAUTH_SECRET=

# Base URL the camp demo seeders point at (scripts/seed-demo-camp.mjs,
# scripts/seed-demo-camps-extra.mjs). They drive the REAL HTTP APIs, so
# they need a running dev server. Defaults to http://localhost:3000;
# set this when Next picks another port.
CAMP_BASE=http://localhost:3000

# scripts/study-bank/make-attack.mjs — SPLIT=n deals one item per passage group per file
SPLIT=
# scripts/study-bank/sec-qc-aggregate.mjs — TAG=<solver file prefix>, BATCHES=<comma-separated batch files>, DROP=<ids to exclude>
TAG=
BATCHES=
DROP=
# scripts/study-bank/draw-review-run.mjs — restrict a sitting to one cohort
DRAW_COHORT=
# DRAW_GROUP  restrict a review draw to passage_group_id(s), comma-separated (spot-check route, 2026-10-22; several = a 12-item spot, 2026-10-23)
DRAW_GROUP=
# scripts/study-bank/verify-sat-hard-route.ts — read-only now (in-memory exposures); optional path to an alternate assemble.ts for a before/after run
ASSEMBLE_MODULE=
# scripts/study-bank/act-bank-helper.mjs and toefl-bank-helper.mjs insert-listening — BANK_VERIFIED=false stages a cohort (not servable) until a human sitting clears it
BANK_VERIFIED=
# scripts/study-bank/map-lu-v2.mjs — MLV2_W=<work dir> runs the toolchain on a scratch copy (default scripts/study-bank/map-lu-v2/)
MLV2_W=
# scripts/study-bank/map-lu-v3.mjs — MLV3_W=<work dir> runs the toolchain on a scratch copy (default scripts/study-bank/map-lu-v3/)
MLV3_W=
# scripts/study-bank/map-lu-v4.mjs — MLV4_W=<work dir> runs the toolchain on a scratch copy (default scripts/study-bank/map-lu-v4/)
MLV4_W=
# scripts/study-bank/map-lu-v5.mjs — MLV5_W=<work dir> runs the toolchain on a scratch copy (default scripts/study-bank/map-lu-v5/)
MLV5_W=
# scripts/study-bank/map-lu-v6.mjs — MLV6_W=<work dir> runs the toolchain on a scratch copy (default scripts/study-bank/map-lu-v6/)
MLV6_W=

# --- scripts/shots/desktop.mjs (desktop captures of the study surface) ---
# All optional; the script runs with none of them set.
# BASE      origin to capture, default http://localhost:3000
# WIDTHS    comma-separated viewport widths, default 1440
# LANG_UI   english | korean, written to user_preferences before capture
# SETTLE    ms to wait after networkidle before the shot, default 3000
# SHOTS     comma-separated shot names to capture, default all

# --- scripts/study-bank/form-capacity.mjs ---
# TARGET    forms per section to size the item gap against, e.g. 100. Unset = off.
TARGET=
BASE=
WIDTHS=
LANG_UI=
SETTLE=
SHOTS=

# --- scripts/shots/intro-shots.mjs (study captures for the introduction doc) ---
# All optional; the script runs with none of them set.
# LANGS     comma-separated: english,korean — which editions to capture
# ONLY      comma-separated shot names, default all
# SAT_SLUG  SAT topic slug to open, default sat-reading-writing
LANGS=
ONLY=
# RESULT_SESSION  study session id to capture on the result screen (both
#                 editions), default the demo account's stored sessions
# MODE            manager = capture academy/manager screens instead of the student surface
SAT_SLUG=
RESULT_SESSION=
MODE=

# --- scripts/shots/_render-intro.mjs / _render-intro-ko.mjs (build the PDF) ---
# All optional. Unset renders the 13-page A4 screen edition.
# SIZE      b5 = JIS B5 (182x257mm), scaled from the A4 layout
# BLEED     1 = add 3mm bleed on every side, for a print shop
# PRINT16   1 = saddle-stitch layout: inside covers + FAQ page = 16 pages
SIZE=
BLEED=
PRINT16=

# --- scripts/shots/_render-split.mjs (academy + Study split documents) ---
# Also reads SIZE and BLEED above.
# PRINT     1 = print edition (padded to a multiple of 4 pages); PRINT16 also works
# PNG       1 = write one PNG per page for visual checking
# Combined-booklet parts (set by _render-combo.mjs; all default off):
# FOLIO_OFFSET  number this part's pages from FOLIO_OFFSET + 1
# FOLIO_TOTAL   the "NN / TT" total across the whole booklet
# TP_MAP        JSON {contents ref: page} for contents entries that point into the other part
# REFDUMP       file to write every section id -> page to
PRINT=
PNG=
FOLIO_OFFSET=
FOLIO_TOTAL=
TP_MAP=
REFDUMP=

# --- scripts/shots/mobile-fingerprint.mjs ---
# PAGE      single route to fingerprint, default the study home
PAGE=

# --- scripts/study-bank/secliv-match.mjs, seclive-pop.mjs ---
# OUT       file to write the match/population report to
# DOM       restrict the run to one SAT domain
OUT=
DOM=

# --- scripts/study-bank/difficulty-policy.mjs ---
# BANK_BAND   band a batch inserts at: hard | mixed. Decides whether items the
#             graders called easy are REJECTED at insert (hard) or banked at
#             their graded difficulty (mixed). Never used to relabel an item.
BANK_BAND=

# --- scripts/study-bank/bank-helper.mjs ---
# BLIND       write the blind render instead of inserting
BLIND=

# --- scripts/study-bank/sec-qc-aggregate.mjs ---
# BATCH       comma-separated batch files to fold into one qc ledger
# SOLVER_DIR  directory holding the <tag>.solver-{a,b,c}.json files
BATCH=
SOLVER_DIR=

# --- scripts/study-bank/math-qc-aggregate.mjs ---
# REGRADE     re-fold an existing grade rather than starting a new one
# ROUTED      score only the items the hard route would actually draw
REGRADE=
ROUTED=
# PROJECT_COHORT  form-capacity.mjs: count this cohort's STAGED rows as if
#                 verified, to project what it buys once a sitting clears it
PROJECT_COHORT=

# --- scripts/study-bank/essay-bank-helper.mjs ---
# ESSAY_COHORT   cohort label written onto inserted essay prompts
# ESSAY_PROMPTS  path to the prompts file to insert
ESSAY_COHORT=
ESSAY_PROMPTS=

# ── Auth email (Supabase Send Email hook → Resend) ──────────────────────────
# Resend API key + verified sender; without the key the hook DRY-RUNS outside production.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Classraum <no-reply@classraum.com>
# Secret shown by Supabase Dashboard → Auth → Hooks → Send Email (starts with v1,whsec_).
SEND_EMAIL_HOOK_SECRET=
# Origin the confirmation links land on when redirect_to is absent.
AUTH_EMAIL_APP_ORIGIN=https://app.classraum.com

# ── study-bank script knobs (scripts/study-bank, never read by the app) ─────
# actrd-control-draw.mjs: how many control files to draw.
FILES=3
# admission-form-depth.ts: set to 1 to reuse the last draw instead of a fresh one.
NO_FRESH=
# check-tightest-pair.mjs: 'abs' (default) or 'ratio' distance metric.
TAP_METRIC=abs
# toefl-form-depth.ts: how many sittings to simulate per path (default 60).
MAX_SITTINGS=60
# toefl-form-depth.ts: independent trials per path, each a fresh student (default 3).
TRIALS=3
# scripts/study-bank/toefl-depth-work/depth-inject.ts (sizing copy of toefl-form-depth.ts): fake Announcement sets to add, "count x size : band" comma-separated, e.g. 6x2:easy
INJECT=
# depth-inject.ts: load a STAGED (verified=false) listening cohort into the replay as if released, e.g. announcement-v6 (projected depth)
STAGED_COHORT=
# checker-input.breaktest.mjs: set to any value to print each checker's raw output.
VERBOSE=
# form-qc.ts: consecutive forms to build per section/variant (default 6).
FORMS=6
# form-qc.ts: set to 1 to serve unpaged bank reads WITHOUT PostgREST's 1000-row cap.
UNCAPPED=

# ── Study receipts: seller block in the receipt email footer (optional) ────
# The Inicis card slip linked from every receipt already carries the merchant's
# registered details; these print them in the email too when set.
RECEIPT_SELLER_NAME=
RECEIPT_SELLER_REPRESENTATIVE=
RECEIPT_SELLER_BUSINESS_NUMBER=
RECEIPT_SELLER_MAIL_ORDER_NUMBER=
RECEIPT_SELLER_ADDRESS=
RECEIPT_SELLER_CONTACT=support@classraum.com

# --- scripts/study-bank/admission-form-depth.ts ---
# SHARED_POOL  0 = old behaviour: ISEE Quantitative and Mathematics counted as
#              separate pools (wrong: the app shares one seen-list). Unset = shared.
SHARED_POOL=

# --- scripts/study-bank/act-english-v8-dupscan.mjs ---
# PLANT  1 = plant a copy of a live passage to prove the scan catches it (self-test)
PLANT=

# --- scripts/study-bank/draw-review-run.mjs ---
# DRAW_FIRST  item id to place first in a drawn review run (e.g. the flagged item a reader must reach)
DRAW_FIRST=

# --- scripts/study-bank/math-mechanism-dup.mjs ---
# MMD_ABLATE  comma-separated scoring channels to switch off, for break-testing which channel finds a duplicate
MMD_ABLATE=

# --- scripts/study-bank/draw-next.mjs ---
# QUEUE_FILE  a test queue file in place of scripts/study-bank/cofounder-queue.json
QUEUE_FILE=

# --- scripts/study-bank/draw-review-run.mjs (Amendment 3, 2026-10-23) ---
# DRAW_COHORT also takes 'cohortA:3,cohortB:2,...' = one POOLED run with per-cohort quotas (domain arg '*' or one domain)
# DRAW_DRY  1 = print the sample and the key deal, insert nothing (check a pooled or multi-group draw against the live bank)
DRAW_DRY=
# DRAW_IDS_FILE  JSON array of item ids: a review draw serves only these (agent-review pre-release audit, 2026-10-29; keeps agent-dropped items out)
DRAW_IDS_FILE=
# DRAW_VERIFIED  1 = draw live (verified) rows only: the weekly audit run of AI-only releases
DRAW_VERIFIED=

# --- scripts/study-bank/draw-toefl-conv-runs.mjs ---
# DRAW_SETS  number of whole sets in the run instead of the cohort's default (a 12-item spot of 5-item passages is 3)
DRAW_SETS=

# --- scripts/study-bank/autonomy-state.mjs / draw-next.mjs / release-by-shape.mjs (Amendment 3 trust levels) ---
# AUTONOMY_NOTES_FILE  the co-founder notes ledger in place of scripts/study-bank/cofounder-notes.json (test ledgers)
AUTONOMY_NOTES_FILE=
# AUTONOMY_STATE_FILE  where autonomy-state.mjs writes, and draw-next.mjs reads, the trust-level state (default
#   scripts/study-bank/autonomy-state.json). draw-next.mjs switches to level-aware mode when this file exists.
AUTONOMY_STATE_FILE=
# scripts/study-bank/check-math-near-dup.mjs: set to 1 to skip the 30-minute local cache of live maths rows and always
#   page the live bank (the cache is reused only while the live row count still matches).
NEAR_DUP_FRESH=

# Datadog RUM / browser logs (src/lib/datadog/rum.ts). The app id and client
# token are public and have defaults in code; set these only to point at a
# re-created RUM app. NEXT_PUBLIC_DD_RUM_FORCE=1 reports from any host
# (localhost, previews) for testing the wiring; production reports without it.
NEXT_PUBLIC_DD_RUM_APPLICATION_ID=
NEXT_PUBLIC_DD_RUM_CLIENT_TOKEN=
NEXT_PUBLIC_DD_RUM_FORCE=
# Set by Vercel at build time; tags RUM events with the release.
NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA=
