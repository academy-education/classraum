<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep Linking: Custom URL Scheme (classraum://) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="classraum" />
            </intent-filter>

            <!-- Deep Linking: Universal Links (https://app.classraum.com)
                 CLAIM PATHS, NEVER THE WHOLE HOST. This filter used to be a
                 bare host match, which made the app the verified handler for
                 EVERY app.classraum.com URL — including the ones we hand to
                 the OS on purpose. "Subscribe on web" opens
                 /auth?next=/mobile/study/subscription in a Chrome Custom Tab;
                 Custom Tabs honour verified app links, so Android handed the
                 URL straight back to MainActivity (launchMode=singleTask
                 fronts the existing task) and the student landed back on the
                 same screen having paid nothing, with no error to show.
                 iOS was unaffected because SFSafariViewController deliberately
                 does NOT fire universal links back into the presenting app —
                 which is exactly why this read as Android-only.
                 The same trap applied to /auth/callback: an OAuth return
                 inside the Custom Tab would bounce into the app mid-login.
                 So: list only paths that are real deep-link destinations
                 (see mobilePaths in src/hooks/useNativeApp.ts). /auth and
                 /mobile/study/** are deliberately NOT claimed — the whole
                 web-checkout flow lives there and must stay in the browser.
                 Push notifications route via the classraum:// scheme above,
                 not https, so nothing here depends on a blanket claim. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="app.classraum.com" android:pathPrefix="/dashboard" />
                <data android:scheme="https" android:host="app.classraum.com" android:pathPrefix="/invite/" />
                <data android:scheme="https" android:host="app.classraum.com" android:pathPrefix="/mobile/session" />
                <data android:scheme="https" android:host="app.classraum.com" android:pathPrefix="/mobile/assignment" />
                <data android:scheme="https" android:host="app.classraum.com" android:pathPrefix="/mobile/schedule" />
                <data android:scheme="https" android:host="app.classraum.com" android:pathPrefix="/mobile/messages" />
                <data android:scheme="https" android:host="app.classraum.com" android:pathPrefix="/mobile/notifications" />
                <data android:scheme="https" android:host="app.classraum.com" android:pathPrefix="/mobile/profile" />
                <data android:scheme="https" android:host="app.classraum.com" android:pathPrefix="/mobile/reports" />
                <data android:scheme="https" android:host="app.classraum.com" android:pathPrefix="/mobile/invoices" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Chrome Custom Tabs needs to SEE a browser to hand a URL to.
         targetSdk is 35, and from API 30 package visibility is filtered:
         without this <queries> block CustomTabsClient cannot resolve any
         browser package, so Browser.open() fails. openExternalUrl() is the
         only way out of the WebView (Android's WebView silently discards
         target="_blank"), so a failure there is a dead end for every
         external link — web checkout, gift redemption, the policy pages. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Camera permissions -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Microphone: spoken answers in TOEFL Speaking practice + voice input in the
         AI tutor, all via getUserMedia({audio:true}) inside the WebView.
         BOTH are required. Capacitor's own BridgeWebChromeClient.onPermissionRequest
         maps AUDIO_CAPTURE to {MODIFY_AUDIO_SETTINGS, RECORD_AUDIO} and launches a
         single multi-permission request; an undeclared permission is auto-denied with
         no dialog, and the callback grants only if ALL come back granted. Declaring
         just RECORD_AUDIO would therefore still fail, silently. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Block storage permissions - using Android Photo Picker instead -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" tools:node="remove" />

    <!-- Push notification permissions -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
</manifest>
